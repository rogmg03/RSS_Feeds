@model RSS_Feeds.MVC.Models.RegisterViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-page">
    <div class="auth-shell">

        <!-- HERO / BRAND -->
        <section class="auth-hero" aria-label="Brand panel">
            <div class="hero-content">

                <div class="brand">
                    <div class="brand-mark" aria-hidden="true">RS</div>
                    <div class="brand-text">
                        <div class="brand-name">RSS Feeds</div>
                        <div class="brand-tag">Curated Stream</div>
                    </div>
                </div>

                <h1 class="hero-title">Empieza a curar tu conocimiento.</h1>
                <p class="hero-subtitle">
                    Crea tu cuenta y comienza a seguir las fuentes que realmente importan para ti.
                </p>

                <div class="hero-bullets" aria-label="Highlights">
                    <div class="bullet">
                        <span class="dot" aria-hidden="true"></span>
                        <span>Sigue feeds de tu interés</span>
                    </div>
                    <div class="bullet">
                        <span class="dot" aria-hidden="true"></span>
                        <span>Guarda artículos con un “like”</span>
                    </div>
                    <div class="bullet">
                        <span class="dot" aria-hidden="true"></span>
                        <span>Construye tu propio stream</span>
                    </div>
                </div>

                <div class="hero-footer">
                    <span class="pill">Gratis</span>
                    <span class="pill">Privado</span>
                    <span class="pill">Sin ruido</span>
                </div>

            </div>

            <div class="hero-glow" aria-hidden="true"></div>
        </section>

        <!-- FORM -->
        <section class="auth-card" aria-label="Register form">
            <div class="card-header">
                <h2 class="card-title">Crear cuenta</h2>
                <p class="card-subtitle">
                    Completa los datos para empezar tu experiencia.
                </p>
            </div>

            <form method="post" class="auth-form" novalidate>

                <!-- EMAIL -->
                <div class="field">
                    <label class="label" asp-for="Email">Email</label>
                    <div class="input-wrap">
                        <span class="icon" aria-hidden="true">
                            <!-- mail icon -->
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v9A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-9Z" stroke="currentColor" stroke-width="1.7" />
                                <path d="M6.5 7.5 12 12l5.5-4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>

                        <input class="input"
                               asp-for="Email"
                               type="email"
                               autocomplete="email"
                               placeholder="tu@email.com"
                               autofocus />
                    </div>
                </div>

                <!-- NOMBRE -->
                <div class="field">
                    <label class="label" asp-for="Nombre">Nombre</label>
                    <div class="input-wrap">
                        <span class="icon" aria-hidden="true">
                            <!-- user icon -->
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z" stroke="currentColor" stroke-width="1.7" />
                                <path d="M4.5 20a7.5 7.5 0 0 1 15 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                            </svg>
                        </span>

                        <input class="input"
                               asp-for="Nombre"
                               type="text"
                               autocomplete="name"
                               placeholder="Tu nombre" />
                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="field">
                    <label class="label" asp-for="Password">Password</label>
                    <div class="input-wrap">
                        <span class="icon" aria-hidden="true">
                            <!-- lock icon -->
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M7.5 10V8.2a4.5 4.5 0 0 1 9 0V10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                <path d="M6.8 10h10.4A2.8 2.8 0 0 1 20 12.8v4.4A2.8 2.8 0 0 1 17.2 20H6.8A2.8 2.8 0 0 1 4 17.2v-4.4A2.8 2.8 0 0 1 6.8 10Z" stroke="currentColor" stroke-width="1.7" />
                            </svg>
                        </span>

                        <input class="input"
                               asp-for="Password"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Crea una contraseña"
                               id="passwordInput" />
                    </div>
                </div>

                <!-- CONFIRM PASSWORD -->
                <div class="field">
                    <label class="label" asp-for="ConfirmPassword">Confirmar password</label>
                    <div class="input-wrap">
                        <span class="icon" aria-hidden="true">
                            <!-- lock check icon -->
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M7.5 10V8.2a4.5 4.5 0 0 1 9 0V10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                                <path d="M6.8 10h10.4A2.8 2.8 0 0 1 20 12.8v4.4A2.8 2.8 0 0 1 17.2 20H6.8A2.8 2.8 0 0 1 4 17.2v-4.4A2.8 2.8 0 0 1 6.8 10Z" stroke="currentColor" stroke-width="1.7" />
                                <path d="m9.5 15 1.8 1.8 3.7-3.7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>

                        <input class="input"
                               asp-for="ConfirmPassword"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Repite la contraseña" />
                    </div>
                </div>

                <!-- ERROR -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        <div class="alert-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M12 9v5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                                <path d="M12 17.6h.01" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
                                <path d="M10.3 4.7a2 2 0 0 1 3.4 0l8 14A2 2 0 0 1 20 21H4a2 2 0 0 1-1.7-3.3l8-14Z" stroke="currentColor" stroke-width="1.7" />
                            </svg>
                        </div>
                        <div class="alert-text">@Model.ErrorMessage</div>
                    </div>
                }

                <!-- SUBMIT -->
                <button type="submit" class="btn-primary">
                    <span>Crear cuenta</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                </button>

                <div class="divider">
                    <span>o</span>
                </div>

                <div class="meta-row">
                    <span>¿Ya tienes cuenta?</span>
                    <a class="link" asp-controller="Account" asp-action="Login">
                        Inicia sesión
                    </a>
                </div>

            </form>
        </section>

    </div>
</div>
