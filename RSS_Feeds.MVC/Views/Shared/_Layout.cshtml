<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · RSS Feeds</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- SIDEBAR OVERLAY (Mobile only) -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <div class="brand-mark">RS</div>
                <div class="brand-text">
                    <div class="brand-name">RSS Feeds</div>
                    <div class="brand-tag">Curated Stream</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="nav-item">
                    <span class="icon">🏠</span>
                    <span>Home</span>
                </a>

                <a asp-controller="Feeds" asp-action="Discover" class="nav-item">
                    <span class="icon">🔍</span>
                    <span>Discover</span>
                </a>

                <a asp-controller="Feeds" asp-action="Saved" class="nav-item">
                    <span class="icon">❤️</span>
                    <span>Saved</span>
                </a>

                <a asp-controller="Account" asp-action="Logout" class="nav-item danger">
                    <span class="icon">⎋</span>
                    <span>Logout</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN -->
        <div class="main-area">

            <!-- TOP BAR -->
            <header class="topbar">
                <div class="search-box">
                    <button class="hamburger-btn" id="sidebarToggle" aria-label="Toggle sidebar">
                        <span class="hamburger-icon">☰</span>
                    </button>
                    <input type="text" placeholder="Buscar feeds, temas o fuentes…" />
                </div>

                <div class="user-box">
                    <div class="user-name">
                        @Context.Session.GetString("UserNombre")
                    </div>
                    <div class="user-email">
                        @Context.Session.GetString("UserEmail")
                    </div>
                </div>
            </header>

            <!-- PAGE CONTENT -->
            <main>
                @RenderBody()
            </main>

        </div>

        <!-- BOTTOM NAVIGATION (Mobile only) -->
        <nav class="bottom-nav">
            <a asp-controller="Home" asp-action="Index" class="bottom-nav-item">
                <span class="icon">🏠</span>
                <span class="label">Home</span>
            </a>

            <a asp-controller="Feeds" asp-action="Discover" class="bottom-nav-item">
                <span class="icon">🔍</span>
                <span class="label">Discover</span>
            </a>

            <a asp-controller="Feeds" asp-action="Saved" class="bottom-nav-item">
                <span class="icon">❤️</span>
                <span class="label">Saved</span>
            </a>

            <a asp-controller="Account" asp-action="Logout" class="bottom-nav-item danger">
                <span class="icon">⎋</span>
                <span class="label">Logout</span>
            </a>
        </nav>
    </div>

    <!-- SCRIPTS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
