@model List<RSS_Feeds.MVC.Models.SavedArticleViewModel>

@{
    ViewData["Title"] = "Guardados";
}

<div class="content">

    @if (ViewBag.EmptySaved == true)
    {
        <section class="empty-feed">
            <div class="empty-illustration">❤️</div>

            <h1>No tienes artículos guardados</h1>
            <p>
                Guarda artículos para leerlos después.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn-primary">
                Ir al feed
            </a>
        </section>
    }
    else
    {
        <section class="feed-list-grid">

            @foreach (var item in Model)
            {
                <article class="feed-card">
                    @if (!string.IsNullOrWhiteSpace(item.Imagen))
                    {
                        <div class="feed-card-image-wrapper">
                            <img src="@item.Imagen"
                                 class="feed-card-image"
                                 alt="@item.Titulo" />
                        </div>
                    }

                    <div class="feed-card-body">
                        <h2 class="feed-card-title">
                            @item.Titulo
                        </h2>

                        @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                        {
                            <p class="feed-card-description">
                                @item.Descripcion
                            </p>
                        }

                        <div class="feed-card-meta">
                            <span class="feed-source">
                                @item.FeedTitulo
                            </span>

                            @if (item.FechaPublicacion.HasValue)
                            {
                                <span class="feed-date">
                                    @item.FechaPublicacion.Value.ToString("dd MMM yyyy")
                                </span>
                            }
                        </div>

                        <div class="feed-card-actions">
                            <!-- UNLIKE -->
                            <button class="like-btn liked"
                                    data-guardado-id="@item.UsuarioArticuloGuardadoId"
                                    title="Quitar de guardados">
                                ❤️
                            </button>

                            <a href="@item.Link"
                               target="_blank"
                               rel="noopener"
                               class="btn-read">
                                Leer
                            </a>
                        </div>
                    </div>
                </article>
            }

        </section>
    }

</div>
